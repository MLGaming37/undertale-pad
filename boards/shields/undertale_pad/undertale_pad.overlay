#include <dt-bindings/zmk/matrix_transform.h>

/ {
    chosen {
        zmk,kscan = &kscan0;
        zmk,matrix-transform = &default_transform;
    };

    default_transform: keymap_transform_0 {
        compatible = "zmk,matrix-transform";
        columns = <7>;
        rows = <1>;
        map = <
            RC(0,0) RC(0,1) RC(0,2) RC(0,3)
            RC(0,4) RC(0,5) RC(0,6)
        >;
    };

    kscan0: kscan_0 {
        compatible = "zmk,kscan-gpio-direct";
        wakeup-source;
        input-gpios
            = <&pro_micro 1 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>  // UP    (P0.06)
            , <&pro_micro 0 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>  // DOWN  (P0.08)
            , <&pro_micro 2 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>  // LEFT  (P0.17)
            , <&pro_micro 3 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>  // RIGHT (P0.20)
            , <&pro_micro 4 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>  // Z     (P0.22)
            , <&pro_micro 5 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>  // X     (P0.24)
            , <&pro_micro 6 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>  // C     (P1.00)
            ;
    };
};
